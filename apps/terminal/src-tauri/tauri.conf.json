{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kerstel Terminal",
  "version": "0.4.0",
  "identifier": "dev.kerstel.terminal",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "bun run prepare-app",
    "beforeBuildCommand": "bun run prepare-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kerstel Terminal",
        "width": 900,
        "height": 580,
        "minWidth": 420,
        "minHeight": 260,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#202124"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/kerstel"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "shortDescription": "A calm terminal with Kerstel built in",
    "longDescription": "Kerstel Terminal runs your own shell with a folder and branch bar, a quiet divider and exit status for each command, key hints, a command palette, and a panel for Kerstel secrets and sync.",
    "copyright": "MIT License"
  }
}
